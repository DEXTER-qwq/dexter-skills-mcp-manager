{
  "name": "@weibaohui/skills-management",
  "version": "0.7.0-local",
  "private": true,
  "description": "dsh 插件 · 技能管理（本地版）：一个页面管理本机所有 coding agent 的技能目录（Claude、ZCode、Codex 等十余个执行器），可预览、收编进 DSH 用户库供 skill 工具调用；已移除 ntd 市场仓库同步与 GitCode 分享功能，运行期无任何网络请求、无子进程、无第三方运行期依赖。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "skills",
    "dsh-plugin"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.5",
    "dsh": ">=0.1.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check src/mcp-manager.js && node --check client/index.js",
    "test": "node --test test/*.test.mjs",
    "build:client": "node scripts/build-client.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weibaohui/skills-management.git"
  },
  "homepage": "https://github.com/weibaohui/skills-management#readme",
  "bugs": {
    "url": "https://github.com/weibaohui/skills-management/issues"
  }
}
